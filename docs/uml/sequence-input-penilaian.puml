@startuml
title Sequence Diagram - Input Penilaian

actor "Operator" as operator
participant "Form Penilaian" as form
participant "Penilaian Action" as action
participant "Database" as db

operator -> form : akses halaman penilaian
form -> db : SELECT alternatif, sub_kriteria
db --> form : data master
form --> operator : tampilkan form penilaian\n  (dropdown sub-kriteria per kriteria)
operator -> form : pilih sub-kriteria untuk\n  tiap alternatif & kriteria
operator -> form : klik "Simpan"
form -> action : POST data penilaian\n  penilaian[alt_id][kriteria_id]
action -> db : DELETE FROM penilaian
action -> db : INSERT penilaian\n  (alternatif_id, sub_kriteria_id, nilai=bobot)
db --> action : data tersimpan
action --> form : redirect + pesan sukses
form --> operator : "Penilaian berhasil disimpan"
@enduml
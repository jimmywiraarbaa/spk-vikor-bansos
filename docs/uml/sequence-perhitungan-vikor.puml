@startuml
title Sequence Diagram - Perhitungan VIKOR

actor "Operator" as operator
participant "Halaman Perhitungan" as page
participant "Database" as db

operator -> page : akses halaman perhitungan
page -> db : SELECT alternatif, kriteria,\n  sub_kriteria, penilaian
db --> page : data mentah
page -> page : petakan penilaian per alternatif\n  ke nilai per kriteria via sub_kriteria
page -> page : tentukan f* (min) dan f- (max)\n  per kriteria (cost/benefit)
page -> page : hitung S (utility)\n  dan R (regret) per alternatif
page -> page : hitung Q (VIKOR index)\n  dan ranking
page --> operator : tampilkan tabel S, R, Q, Ranking
operator -> page : klik "Simpan Hasil"
page -> db : DELETE FROM hasil_perhitungan
page -> db : INSERT hasil_perhitungan\n  (nilai_s, nilai_r, nilai_q, ranking)
db --> page : data tersimpan
page --> operator : "Hasil berhasil disimpan"
@enduml